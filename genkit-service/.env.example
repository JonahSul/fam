# GenKit Service - Environment Configuration Example
# Copy this file to `.env` and fill in the appropriate values.

# --- Server ---
# Port the GenKit service listens on
PORT=3000

# Node environment (development|production|test)
NODE_ENV=development

# --- AI Providers ---
# At least one provider key must be set or chat will fail.
# OpenAI API key (preferred provider)
OPENAI_API_KEY=
# Anthropic API key (fallback if OpenAI is unavailable)
ANTHROPIC_API_KEY=

# --- Google APIs (optional; required for Calendar/Gmail/Meet tools) ---
# Used by Calendar, Gmail, and Google Meet tools
GOOGLE_API_KEY=

# --- Agent Mode Configuration ---
# Master switch for agent mode. When true, /agent-mode/* endpoints are active,
# and /chat can route through agent mode when agent=true in the request body.
AGENT_MODE_ENABLED=false

# Max concurrent tool executions
AGENT_MAX_CONCURRENT_EXECUTIONS=3

# Comma-separated tool names exposed to the model.
# Meeting tools:
#  - search_meetings
#  - get_todays_meetings
#  - get_meetings_for_day
#  - get_meetings_near_location
#  - get_meetings_by_format
# Additional families (require GOOGLE_API_KEY and service setup):
#  - TODO tools (e.g., get_user_todos, complete_todo)
#  - Calendar tools (e.g., create_calendar_event)
#  - Gmail tools (e.g., send_email)
#  - Meet tools (e.g., schedule_meet)
AGENT_ALLOWED_TOOLS=search_meetings,get_todays_meetings,get_meetings_for_day,get_meetings_near_location,get_meetings_by_format

# Ask for confirmation before sensitive actions
AGENT_REQUIRE_CONFIRMATION=false

# Auto-execute allowed tools without confirmation
AGENT_AUTO_EXECUTE=true

# --- BMLT (Meeting Data) ---
# Base URL for the BMLT API (defaults to Montana region)
BMLT_API_BASE=https://bmlt.mtrna.org/prod

# Custom User-Agent for outbound BMLT requests
USER_AGENT=fam-genkit-service/1.0.0

# --- CORS (optional) ---
# Note: CORS origins are currently set in code. If you need to customize,
# update src/index.ts to read an env var (e.g., CORS_ORIGINS) and document it here.